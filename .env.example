# Origem dos downloads. Deixe vazio quando /windows e /linux estiverem no mesmo domínio do site.
VITE_DOWNLOAD_ORIGIN=

# Opcional: endpoint JSON agregador. Quando vazio, o site lê os três manifestos YAML diretamente.
VITE_DOWNLOAD_MANIFEST_ENDPOINT=

# Supabase usado pelo formulário de feedback e ajuda.
# Use somente a chave anon/publishable. Nunca exponha a service_role no site.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_CHAVE_ANON_OU_PUBLISHABLE
VITE_LAUNCH_AT=2026-08-11T13:00:00-03:00
